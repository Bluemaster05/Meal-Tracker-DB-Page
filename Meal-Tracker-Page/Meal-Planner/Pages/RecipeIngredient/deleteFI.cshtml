@page
@model Meal_Planner.Pages.FoodItems.DeleteModel

@{
    ViewData["Title"] = "Delete Food Item";
}

<h1>Delete Food Item</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>@Model.FoodItem.Name</h4>
    <p>@Model.FoodItem.Description</p>
    <p><strong>Serving Size:</strong> @Model.FoodItem.ServingSize</p>
</div>

<form method="post">
    <input type="hidden" asp-for="FoodItem.ItemId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="/FoodItems/Index" class="btn btn-secondary">Cancel</a>
</form>
