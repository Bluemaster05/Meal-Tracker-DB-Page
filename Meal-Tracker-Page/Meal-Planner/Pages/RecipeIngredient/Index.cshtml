@page
@model Meal_Planner.Pages.RecipeIngredient.IndexModel

@{
    ViewData["Title"] = "Index";
}


<h2>Food Items</h2>
 <p>     
     <a class="btn btn-primary" asp-page="createFI">Create New Food Item</a> 
 </p> 


<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FoodItems[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FoodItems[0].ServingSize)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FoodItems[0].Description)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.FoodItems) {
        <tr>
            <td>
                @Html.DisplayFor(modelitem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelitem => item.ServingSize)
            </td>
            <td>
                @Html.DisplayFor(modelitem => item.Description)
            </td>
            <td>
                <a asp-page="deleteFI" asp-route-id="@item.ItemId" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>






 <p>     
     <a class="btn btn-primary" asp-page="Create">Create New RecipeIngredient</a> 
 </p> 
<h2>Ingredients in Food Items</h2>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RecipeIngredient[0].Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RecipeIngredient[0].Item)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RecipeIngredient[0].Ingredient)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.RecipeIngredient) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Amount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ingredient.Name)
            </td>
            <td>
                <a class="btn btn-sm btn-secondary" href="RecipeIngredient/Edit?itemId=@item.ItemId&ingredientId=@item.IngredientId">Edit</a> 
                <a class="btn btn-sm btn-danger" href="RecipeIngredient/Delete?itemId=@item.ItemId&ingredientId=@item.IngredientId">DeleteMe</a
                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
            </td>
        </tr>
}
    </tbody>
</table>