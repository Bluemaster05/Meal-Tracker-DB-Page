@page
@model Meal_Planner.Pages.RecipeIngredient.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<div id="silly-list">
</div>
<form hx-get="/Htmx/Silly" hx-target="#silly-list" hx-swap="beforeend">
    <input name="itemId" />
    <button>Submit</button>
</form>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.RecipeIngredient[0].Amount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RecipeIngredient[0].Ingredient)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RecipeIngredient[0].Item)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.RecipeIngredient) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Amount)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ingredient.IngredientId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Item.ItemId)
            </td>
            <td>
                <a href="RecipeIngredient/Edit?itemId=@item.ItemId&ingredientId=@item.IngredientId">Edit</a> |
                @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
            </td>
        </tr>
}
    </tbody>
</table>