@page
@model Meal_Planner.Pages.mealModel
@using Meal_Planner.Models

@{
    ViewData["Title"] = "meal";
}

<h1>@Html.DisplayFor(model => model.Meal.Name)</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Meal.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Meal.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Meal.Description)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Meal.Description)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Meal.MealId">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>

<hr />

@* <h2>Ingredients in @Html.DisplayFor(model => model.Meal.Name)</h2> *@

@* <ul> *@
@*     @foreach(var ingr in Model.Ingredients) *@
@*     { *@
@*         <li>@Html.DisplayFor(modelItem => ingr.Name)--@Html.DisplayFor(modelItem => ingr.Calories)</li> *@
@*     } *@
@* </ul> *@
<section class="hstack gap-3">

<div class="p1">

    <h2>Ingredients in @Html.DisplayFor(model => model.Meal.Name)</h2>

    @foreach (var item in Model.Meal.Items) 
    { 
    
    <h4>@item?.Name</h4>
    <ul>
        @foreach (var ri in item.RecipeIngredients)
        {
            <li>
                @ri?.Ingredient?.Name
                @ri?.Amount
                @ri?.Ingredient?.MIdNavigation.Description
            </li>
        }
    </ul>
} 
</div>
<div class="p2">
    <h2>Total Ingredients in @Html.DisplayFor(model => model.Meal.Name)</h2>
    @foreach (KeyValuePair<string, DataEntry> ing in Model.IngList)
    {
        <ul>
            <li>
                @ing.Key
                @ing.Value.Amount
                @ing.Value.Unit
            </li>
        </ul>
    }
</div>
</section>

<h2>Per Serving Nutrional Totals</h2>
<ul>
    <li>Calories: @Model.MealNutritionsum.Calories </li>
    <li>Protein: @Model.MealNutritionsum.Protein grams</li>
    <li>Soduum: @Model.MealNutritionsum.Sodium grams</li>
    <li>Total Sugers: @Model.MealNutritionsum.TotalSugers grams</li>
    <li>Total Fat: @Model.MealNutritionsum.TotalFat grams</li>
    <li>DietaryFiber @Model.MealNutritionsum.DietaryFiber grams</li>
</ul>

<h2>Nutrition Information Per Item</h2>
@foreach (var item in Model.NutritionByItemList)
{
    <h3>@item.Key</h3>
    <ul>
        <li>Calories: @item.Value.Calories</li>
        <li>Protein: @item.Value.Protein</li>
        <li>Sodium: @item.Value.Sodium</li>
        <li>Total Sugars: @item.Value.TotalSugers</li>
        <li>Total Fat: @item.Value.TotalFat</li>
        <li>Dietary Fiber: @item.Value.DietaryFiber</li>
    </ul>
}

