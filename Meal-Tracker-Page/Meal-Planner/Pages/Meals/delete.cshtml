@page
@model Meal_Planner.Pages.Meals.DeleteModel

@{
    ViewData["Title"] = "Delete Meal";
}

<h1>Delete Meal</h1>

<h3>Are you sure you want to delete this meal?</h3>
<div>
    <h4>Meal</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Meal.Name</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Meal.Description</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Meal.MealId" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="/Meals/Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>