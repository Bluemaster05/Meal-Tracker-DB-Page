@page
@model Meal_Planner.Pages.Meals.CreateModel

@{
    ViewData["Title"] = "Create Meal";
}

<h1>Create a New Meal</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Meal.Name" class="control-label"></label>
        <input asp-for="Meal.Name" class="form-control" />
        <span asp-validation-for="Meal.Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Meal.Description" class="control-label"></label>
        <textarea asp-for="Meal.Description" class="form-control"></textarea>
        <span asp-validation-for="Meal.Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-page="/MealView/Index" class="btn btn-secondary">Cancel</a>
</form>
