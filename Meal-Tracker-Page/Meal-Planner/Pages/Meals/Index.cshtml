<table class="table">
    <thead class="">
        <tr>
            <th>Meal Name</th>
            <th>Food Items</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var meal in Model.Meals)
        {
            <tr>
                <td class="align-middle">
                    <strong>@meal.Name</strong>
                </td>
                <td>
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th>Food Item</th>
                                <th style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in meal.Items)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>
                                        <a href="Meals/Deleteitem?itemId=@item.ItemId&mealId=@meal.MealId"
                                           class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </td>
                <td class="align-middle">
                    <div class="d-flex flex-column gap-2">
                        <a asp-page="/Meals/AddItem" asp-route-mealId="@meal.MealId" class="btn btn-sm btn-success">Add Food Item</a>
                        <a asp-page="/Meals/Delete" asp-route-id="@meal.MealId" class="btn btn-sm btn-danger">Delete Meal</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>


