@page
@model Meal_Planner.Pages.Ingredient.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Ingredient[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ingredient[0].Calories)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ingredient[0].Protein)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ingredient[0].Sodium)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ingredient[0].TotalSugers)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ingredient[0].TotalFat)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ingredient[0].DietaryFiber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ingredient[0].MIdNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Ingredient) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Calories)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Protein)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sodium)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalSugers)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalFat)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DietaryFiber)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MIdNavigation.MId)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.IngredientId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.IngredientId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.IngredientId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
