@page
@model Meal_Planner.Pages.Ingredient.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Ingredient</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Ingredient.Name" class="control-label"></label>
                <input asp-for="Ingredient.Name" class="form-control" />
                <span asp-validation-for="Ingredient.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ingredient.MId" class="control-label"></label>
                <select asp-for="Ingredient.MId" class ="form-control" asp-items="ViewBag.MId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Ingredient.Calories" class="control-label"></label>
                <input asp-for="Ingredient.Calories" class="form-control" />
                <span asp-validation-for="Ingredient.Calories" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ingredient.Protein" class="control-label"></label>
                <input asp-for="Ingredient.Protein" class="form-control" />
                <span asp-validation-for="Ingredient.Protein" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ingredient.Sodium" class="control-label"></label>
                <input asp-for="Ingredient.Sodium" class="form-control" />
                <span asp-validation-for="Ingredient.Sodium" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ingredient.TotalSugers" class="control-label"></label>
                <input asp-for="Ingredient.TotalSugers" class="form-control" />
                <span asp-validation-for="Ingredient.TotalSugers" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ingredient.TotalFat" class="control-label"></label>
                <input asp-for="Ingredient.TotalFat" class="form-control" />
                <span asp-validation-for="Ingredient.TotalFat" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ingredient.DietaryFiber" class="control-label"></label>
                <input asp-for="Ingredient.DietaryFiber" class="form-control" />
                <span asp-validation-for="Ingredient.DietaryFiber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
