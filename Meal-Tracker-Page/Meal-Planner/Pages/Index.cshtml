@page
@model Meal_Planner.Pages.Meal.IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center py-5">
    <h1 class="display-4 mb-4">Welcome to your personal meal planner!</h1>

    <div class="d-flex flex-wrap justify-content-center gap-3">
        @foreach (var meal in Model.Meals)
        {
            <a class="btn btn-outline-primary btn-lg px-4 py-2 shadow-sm"
               asp-page="meal"
               asp-route-id="@meal.MealId">
                @meal.Name
            </a>
        }
    </div>
</div>
